#!/usr/bin/env python3
"""mpen disables finger touch while the pen is in use, for devices
where the pen only reaches the OS as touch.

Example: MateBook E + M-Pencil. The pen tip is only reported as a
screen touch, with no proximity or pressure events. While the pen
touches the screen, the finger-touch device is grabbed. Contact alone
drives it.
"""

import argparse
import glob
import sys

try:
    from evdev import InputDevice, ecodes
except ImportError:
    sys.exit("python-evdev is required: sudo pacman -Sy python-evdev")

BTN_TOUCH = ecodes.BTN_TOUCH
MT_TRACKING_ID = ecodes.ABS_MT_TRACKING_ID
TOOL_CODES = {
    ecodes.BTN_TOOL_PEN,
    ecodes.BTN_TOOL_RUBBER,
    ecodes.BTN_TOOL_BRUSH,
    ecodes.BTN_TOOL_PENCIL,
}


def find_device(match, exclude=None):
    """Find an input device by part of its name. A /dev/input/eventN path is opened directly."""
    if match.startswith("/dev/input/"):
        return InputDevice(match)
    for path in sorted(glob.glob("/dev/input/event*")):
        try:
            dev = InputDevice(path)
        except OSError:
            continue
        if match in dev.name and (exclude is None or exclude not in dev.name):
            return dev
    return None


def main():
    ap = argparse.ArgumentParser(description="Disable finger touch while the pen is in use")
    ap.add_argument("--pen", default="Stylus",
                    help="part of the pen device name or an event path (default: %(default)s)")
    ap.add_argument("--touch", default="12d1:10b8",
                    help="part of the finger-touch device name or an event path (default: %(default)s)")
    ap.add_argument("--touch-exclude", default="Stylus",
                    help="name to exclude from the finger-touch match (default: %(default)s)")
    ap.add_argument("--list", action="store_true", help="list devices and exit")
    args = ap.parse_args()

    if args.list:
        for path in sorted(glob.glob("/dev/input/event*")):
            try:
                print(path, InputDevice(path).name)
            except OSError:
                pass
        return 0

    pen = find_device(args.pen)
    if pen is None:
        print(f"Pen not found: {args.pen}", file=sys.stderr)
        return 1
    touch = find_device(args.touch, args.touch_exclude)
    if touch is None:
        print(f"Touch device not found: {args.touch}", file=sys.stderr)
        return 1
    print(f"pen: {pen.path} {pen.name}", flush=True)
    print(f"touch: {touch.path} {touch.name}", flush=True)

    slots = set()
    tool_near = False
    grabbed = False

    def update():
        nonlocal grabbed
        want = bool(slots) or tool_near
        if want and not grabbed:
            touch.grab()
            grabbed = True
            print("Touch disabled", flush=True)
        elif not want and grabbed:
            touch.ungrab()
            grabbed = False
            print("Touch enabled", flush=True)

    try:
        for ev in pen.read_loop():
            if ev.type == ecodes.EV_ABS and ev.code == MT_TRACKING_ID:
                # Single-pen assumption: only track touched vs released
                if ev.value == -1:
                    slots.clear()
                else:
                    slots.add(ev.value)
                update()
            elif ev.type == ecodes.EV_KEY and ev.code == BTN_TOUCH:
                if ev.value == 1:
                    slots.add("btn")
                else:
                    slots.discard("btn")
                update()
            elif ev.type == ecodes.EV_KEY and ev.code in TOOL_CODES:
                tool_near = (ev.value == 1)
                update()
    except OSError as e:
        print(f"Device disconnected: {e}", file=sys.stderr)
        return 2
    finally:
        if grabbed:
            try:
                touch.ungrab()
            except OSError:
                pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
